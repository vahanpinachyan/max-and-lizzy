# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and should never be committed.

# --- Stripe (required for checkout) ---
# Get this from https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) for development.
STRIPE_SECRET_KEY=sk_test_...

# Get this from Stripe Dashboard > Developers > Webhooks after adding an
# endpoint pointing to https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Idram payment system (optional) ---
# Powers the "Idram" payment option on the cart page, alongside Stripe.
# See README "Idram payment integration".
# IDRAM_REC_ACCOUNT is your merchant IdramID; IDRAM_SECRET_KEY is issued by
# Idram together with it, after you give them these three URLs:
#   SUCCESS_URL: https://yourdomain.com/checkout/idram/success
#   FAIL_URL:    https://yourdomain.com/checkout/idram/fail
#   RESULT_URL:  https://yourdomain.com/api/idram/callback
# Leave unset and only card payment (Stripe) is offered.
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=

# --- ArCa / ACBA vPOS payment gateway (optional) ---
# Powers the "Card (ArCa)" payment option on the cart page. See README
# "ARCA (ACBA vPOS) payment integration".
# ARCA_USERNAME/ARCA_PASSWORD are the API login/password ACBA issues after
# you sign a merchant agreement (looks like "<merchantId>_api" / a random
# password). Get them from ACBA's eCommerce team (ecom.support@acba.am).
# ⚠️ The password ACBA first issues must be changed on first login at
# https://epg.arca.am/epg_gui/#login before API calls will work — log in
# there yourself (do not share the password with anyone else) and update
# this value afterwards. The new password must be letters/digits only, no
# symbols.
# Leave unset and only Card (Stripe) / Idram are offered.
ARCA_USERNAME=
ARCA_PASSWORD=

# --- Transactional email (optional but recommended) ---
# Powers order confirmation emails (webhook) and the contact form.
# Get a key from https://resend.com — leave unset to skip emails (the site
# still works; submissions are just logged to the server console instead).
RESEND_API_KEY=

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID (starts with "G-"). Leave unset to
# disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# --- Site URL (used for canonical URLs, sitemap, and JSON-LD) ---
# Set this to your real production domain once you have one.
NEXT_PUBLIC_SITE_URL=https://maxandlizzy.com

# --- Database (admin panel: products, stock, promo codes) ---
# Local dev: leave as-is, a SQLite file is created automatically.
# Production: use a real Postgres connection string (e.g. from Neon —
# neon.tech has a free tier). No schema changes needed to switch; see
# README "Admin panel & database" for the exact steps.
DATABASE_URL="file:./prisma/dev.db"

# Creates the first admin account the first time `npm run db:seed` runs.
# After logging in once, change the password from the admin panel.
ADMIN_BOOTSTRAP_EMAIL=admin@maxandlizzy.am
ADMIN_BOOTSTRAP_PASSWORD=changeme123

# --- Auto-translate (optional) ---
# Powers the "Auto-translate Armenian & Russian from English" button on
# /admin/products/new and edit pages, via the Google Cloud Translation API
# (chosen because it supports Armenian — most translation APIs, e.g. DeepL,
# don't). Get a key from https://console.cloud.google.com/apis/credentials
# after enabling the "Cloud Translation API" on a project — leave unset to
# hide the feature's effect (the button will show a setup error instead of
# translating). Has a small per-character cost after Google's free tier.
GOOGLE_TRANSLATE_API_KEY=

# --- Product photo uploads (optional) ---
# Powers the "+ Add photos" drag-and-drop uploader on the product form.
# In your Vercel project dashboard: Storage -> Create Database -> Blob,
# connect it to this project, and Vercel adds this token automatically.
# For local dev, copy the value from that Blob store's ".env.local" tab.
# Leave unset to hide the feature's effect (upload shows a setup error).
BLOB_READ_WRITE_TOKEN=

# --- Instagram feed (optional) ---
# Powers the "Follow along on Instagram" section on the homepage with real,
# auto-updating posts (newest first, refreshed hourly — no redeploy needed).
# Leave unset to show placeholder tiles instead. Requires an Instagram
# Business/Creator account. See README "Instagram feed" section for the
# full setup steps (Meta for Developers app + long-lived access token).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Email marketing (optional) ---
# Syncs newsletter signups (footer form + welcome modal) and completed
# orders to Omnisend as contacts/events, so campaigns, segmentation, and
# automations (welcome series, abandoned cart, post-purchase) can run there.
# Leave unset to skip — signups/checkout still work, marketing sync is just
# a no-op. Get a key from Omnisend > Store Settings > API & webhooks.
OMNISEND_API_KEY=

# On-site tracking snippet (page views, product browsing) — unlocks browse-
# abandonment automations and richer segmentation on top of the server-side
# sync above. NEXT_PUBLIC_ because it runs in the browser. Find it by
# hovering the store icon in the left sidebar of the Omnisend dashboard →
# "Your brand ID". Leave unset to skip the snippet entirely.
NEXT_PUBLIC_OMNISEND_BRAND_ID=

# --- QA watcher (optional) ---
# Powers the daily automated site-health email (Vercel Cron -> /api/qa-watch,
# see vercel.json), which crawls the live site read-only and emails a report
# of broken pages, broken images, and out-of-stock products. Requires
# RESEND_API_KEY above to actually send. Without QA_REPORT_EMAIL or
# RESEND_API_KEY, the route logs the report instead of emailing it.
# CRON_SECRET should be a random string — it's how the route verifies the
# request actually came from Vercel Cron and not a random visitor hitting
# the URL. Generate one with `openssl rand -hex 32` and set the same value
# here and in Vercel's Environment Variables.
CRON_SECRET=
# Comma-separate multiple addresses if needed.
QA_REPORT_EMAIL=
