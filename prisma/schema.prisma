// Production database (Neon Postgres) — see README "Admin panel & database".
// The schema intentionally avoids SQLite- or Postgres-only features (native
// arrays, JSONB operators) so it works unchanged on either provider.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  // "manager" (full access) or "cashier" (orders only — see lib/admin/permissions.ts)
  role         String         @default("manager")
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
  // Brute-force lockout (see lib/admin/auth.ts loginAction) — resets to 0 on
  // any successful login. lockedUntil is null unless currently locked.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
}

model AdminSession {
  token       String    @id
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model Product {
  id      String @id @default(cuid())
  slug    String @unique
  sku     String

  name   String
  nameHy String?
  nameRu String?

  shortDescription   String
  shortDescriptionHy String?
  shortDescriptionRu String?

  description   String
  descriptionHy String?
  descriptionRu String?

  priceAmd          Int
  compareAtPriceAmd Int?

  category    String
  subcategory String
  ageRange    String
  brand       String

  // JSON-encoded string[] / {src,alt}[] — kept as TEXT for SQLite/Postgres
  // portability rather than native array/JSON column types.
  materials    String
  safetyInfo   String
  images       String
  relatedSlugs String?

  inStock       Boolean @default(true)
  stockQuantity Int?

  featured   Boolean @default(false)
  bestseller Boolean @default(false)
  newArrival Boolean @default(false)

  dimensions       String?
  weightGrams      Int?
  careInstructions String?

  countryOfOrigin  String?
  packageContents  String?
  assemblyRequired Boolean?
  assemblyNote     String?
  supervisionNote  String?
  warranty         String?

  // "max" | "lizzy" | null — powers the Max's Pick / Lizzy's Pick badge.
  pickBy     String?
  pickNote   String?
  pickNoteHy String?
  pickNoteRu String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentOff    Int
  description   String
  descriptionHy String?
  descriptionRu String?
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id               String   @id @default(cuid())
  // Exactly one of these is set, matching which processor the customer
  // paid through — see paymentProvider below.
  idramBillNo      String?  @unique
  arcaOrderId      String?  @unique
  // "idram" | "arca"
  paymentProvider  String   @default("arca")
  customer         Customer @relation(fields: [customerId], references: [id])
  customerId       String
  // "pending" | "ready_for_pickup" | "shipped" | "completed" | "cancelled"
  status           String   @default("pending")
  // "pickup" | "delivery_yerevan" | "delivery_outside" | null (unknown / not collected)
  fulfillmentMethod String?
  totalAmd         Int
  promoCode        String?
  shippingAddress  String?
  customerName     String?
  customerPhone    String?
  giftWrap         Boolean  @default(false)
  giftMessage      String?
  notes            String?
  items            OrderItem[]
  reviews          Review[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// Idram has no server-side "session" object like Stripe does to hold cart
// contents while the customer pays on Idram's site - we have to persist
// that ourselves before redirecting, then look it up again when Idram's
// RESULT_URL callback confirms payment (see app/api/idram/callback).
model PendingIdramOrder {
  id                  String   @id @default(cuid())
  amountAmd           Int
  itemsJson           String
  fulfillmentMethod   String?
  deliveryAddressJson String?
  giftWrap            Boolean  @default(false)
  giftMessage         String?
  notes               String?
  promoCode           String?
  customerEmail       String
  customerName        String?
  customerPhone       String?
  // "en" | "hy" | "ru" — the storefront locale the customer was browsing
  // in at checkout, captured here so the confirmation email (an Omnisend
  // automation triggered off the "placed order" event) can be sent in the
  // right language. See lib/omnisend.ts upsertContact.
  locale              String?
  // "pending" | "confirmed" | "failed"
  status              String   @default("pending")
  createdAt           DateTime @default(now())

  @@index([status])
}

// ACBA/ArCa's EPG gateway has no server-side session object either (same
// situation as PendingIdramOrder above), so cart/customer details are
// persisted here before the customer is redirected to the hosted payment
// page. Unlike Idram, EPG doesn't push a server-to-server confirmation —
// the customer's browser returning to returnUrl (see
// app/(site)/checkout/arca/return) is what triggers us to pull the
// authoritative status via getOrderStatusExtended.do, keyed by epgOrderId.
model PendingArcaOrder {
  id                  String   @id @default(cuid())
  // orderId returned by register.do — null until that call succeeds.
  epgOrderId          String?  @unique
  amountAmd           Int
  itemsJson           String
  fulfillmentMethod   String?
  deliveryAddressJson String?
  giftWrap            Boolean  @default(false)
  giftMessage         String?
  notes               String?
  promoCode           String?
  customerEmail       String
  customerName        String?
  customerPhone       String?
  // "en" | "hy" | "ru" — same purpose as PendingIdramOrder.locale above.
  locale              String?
  // "pending" | "confirmed" | "failed"
  status              String   @default("pending")
  createdAt           DateTime @default(now())

  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String?
  productName String
  // Snapshotted at order time, same reasoning as productName/priceAmd —
  // staff need these to pull the right item off the shelf even if the
  // product is later edited or deleted.
  sku         String?
  imageUrl    String?
  priceAmd    Int
  quantity    Int

  @@index([orderId])
}

// One row per QA watcher run (see app/api/qa-watch/route.ts), kept only to
// diff today's problems against the previous run so the email highlights
// what's new instead of repeating the same known issue every morning.
model QaWatchRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  pageCount Int
  // JSON-encoded array of { key, summary } — see route.ts. TEXT rather than
  // a native Json column, matching this schema's existing SQLite/Postgres
  // portability convention (e.g. Product.images).
  problems  String
}

model Review {
  id          String   @id @default(cuid())
  productSlug String
  // Links the review back to the order it was written from, proving it's a
  // verified purchase. Kept optional + onDelete:SetNull so deleting an order
  // doesn't cascade-delete reviews already published for that product.
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  authorName  String
  rating      Int
  title       String
  body        String
  // Reviews start hidden until a manager approves them in /admin/reviews,
  // so spam or inappropriate submissions never reach the storefront.
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productSlug])
  @@index([orderId])
  @@index([approved])
}
